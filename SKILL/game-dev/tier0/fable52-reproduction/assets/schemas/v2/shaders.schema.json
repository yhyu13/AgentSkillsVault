{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shaders.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entityBase"
          }
        ],
        "required": [
          "representation",
          "stages",
          "compiled_variants"
        ],
        "properties": {
          "kind": {
            "const": "shader_unit"
          },
          "representation": {
            "enum": [
              "complete_source",
              "source_patch",
              "runtime_compiled",
              "ir",
              "binary"
            ]
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "vertex",
                "fragment",
                "compute",
                "post_process"
              ]
            }
          },
          "compiled_variants": {
            "type": "object",
            "required": [
              "status",
              "items"
            ],
            "properties": {
              "status": {
                "enum": [
                  "captured",
                  "not_captured"
                ]
              },
              "items": {
                "type": "array"
              }
            }
          },
          "uniforms": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
