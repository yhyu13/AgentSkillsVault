{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pbr.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entityBase"
          }
        ],
        "required": [
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "renderer_settings",
              "channel_mapping",
              "light",
              "environment_reflection",
              "planar_reflection",
              "post_process",
              "runtime_observation",
              "not_observed"
            ]
          },
          "value": {
            "type": "object"
          },
          "related_entities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
