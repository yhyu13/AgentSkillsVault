{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observedVersion": {
      "type": "object",
      "required": [
        "commit",
        "source_path",
        "source_sha256"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license_spdx": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "id",
        "type",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "type": {
          "enum": [
            "direct_source",
            "runtime_capture",
            "static_inference",
            "visual_observation",
            "third_party_claim",
            "unverified"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entityEvidence": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entityBase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entityEvidence"
          }
        },
        "related_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "included",
        "excluded"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_observed"
          ]
        },
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": [
        "schema_version",
        "demo_id",
        "observed_version",
        "generated_at",
        "evidence_refs",
        "entities",
        "coverage",
        "unknowns"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "demo_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "observed_version": {
          "$ref": "#/$defs/observedVersion"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        }
      }
    }
  }
}
