    "iconscout_free": "https://iconscout.com/free-lottie-animations — mixed licenses.",
    "cc0_packs": "Search 'CC0 lottie' / 'public domain lottie' for attribution-free; rarer but safest.",
    "host": "lottie.host gives stable hotlinkable .json/.lottie URLs once you pick an animation."
  },
